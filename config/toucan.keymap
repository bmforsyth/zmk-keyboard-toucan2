#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM  1
#define SYM  2
#define NAV  3

/ {
    macros {
        // Universal Mac Mic Mute: Ctrl + Opt + Shift + Cmd + M        
        mac_mic_mute: mac_mic_mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(LS(LG(M))))>; 
        };

        // Types ° (Option+Shift+8)
        deg: deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp LA(LS(N8));
        };

        // Types °C (Option+Shift+8, then Shift+C)
        deg_c: deg_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp LA(LS(N8)) &kp LS(C)>;
        };

        // Types °F (Option+Shift+8, then Shift+F)
        deg_f: deg_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp LA(LS(N8)) &kp LS(F)>;
        };
    };

    behaviors {
        // Left-hand Home Row Mods
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            // Only trigger if a key on the right half of the keyboard is pressed
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        // Right-hand Home Row Mods
        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            // Only trigger if a key on the left half of the keyboard is pressed
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        // Thumb Mod-Taps
        mt_thumb: mod_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_THUMB";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB     &kp Q         &kp W         &kp E       &kp R       &kp T                   &kp Y       &kp U       &kp I       &kp O         &kp P             &kp SQT
                &caps_word  &hm_l LCTRL A &hm_l LALT S  &kp D       &lt NAV F   &kp G                   &kp H       &kp J       &kp K       &hm_r RALT L  &hm_r RCTRL SEMI  &kp ENTER
                &sk LSHFT   &kp Z         &kp X         &kp C       &kp V       &kp B                   &kp N       &kp M       &kp COMMA   &kp DOT       &kp FSLH          &sk LSHFT
                                          &mkp mac_mic_mute     &sl SYM     &mt_thumb LGUI SPACE        &mt_thumb RGUI BSPC     &sl NUM     &kp LC(SPACE)           
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &kp ESC      &kp EXCL   &kp AT      &kp HASH    &kp DLLR    &kp PRCNT       &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &trans
                &kp CAPS     &kp N1     &kp N2      &kp N3      &kp N4      &kp N5          &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans
                &sk LS(LGUI) &kp UNDER  &kp MINUS   &kp PLUS    &kp EQUAL   &kp F4          &none      &none      &kp COMMA  &kp DOT    &kp FSLH   &sk LS(LGUI)
                                        &none       &trans      &none                       &none      &trans     &none           
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp ESC      &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS      &kp C_PREV  &kp C_PP      &kp C_NEXT    &none       &none   &kp BSLH   &kp PIPE   &kp TILDE  &kp GRAVE  &trans
                &kp CAPS     &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none       &none   &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &trans
                &sk LS(LGUI) &none                                  &none       &kp C_BRI_DN  &kp C_BRI_UP  &none       &none   &deg       &deg_c     &deg_f     &none      &sk LS(LGUI)
                                                                    &none       &trans        &none                     &none   &trans     &none           
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &bt BT_SEL 2    &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_SEL 3 &none  &none         &kp LG(GRAVE) &kp LS(LG(LBKT)) &kp UP     &kp LS(LG(RBKT)) &kp LG(RBKT) &none
                &none           &kp LCTRL    &kp LALT     &kp LSHFT    &trans &none         &none         &kp LEFT         &kp DOWN   &kp RIGHT        &kp LG(LBKT) &trans
                &kp LSHFT       &bt BT_CLR   &none        &none        &none  &none         &mkp RCLK     &none            &none      &none            &none        &none
                                             &studio_unlock &none  &trans                   &kp DEL       &none        &none           
            >;
        };

        // Extra layers required by ZMK Studio to allow runtime additions
        extra_1 {
            status = "reserved";
        };
        extra_2 {
            status = "reserved";
        };
    };
};
